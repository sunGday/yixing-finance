# copy → deploy/.env on ECS (chmod 600). Never commit real values.

# === API required (prod) ===
FIN_API_TOKEN=
FIN_REQUIRE_TOKEN=1
FIN_CORS_ORIGINS=https://yunrong.ink,https://www.yunrong.ink
FIN_REVENUE_MOCK=0
FIN_DATA_DIR=/data/finance
# FIN_RECHARGE_JSONL=/data/finance/billHis-1001108443.jsonl

# === Docker network shared with Nginx Proxy Manager ===
# Default matches this ECS. Change only if `docker network ls` shows another name.
# Non-NPM hosts: `docker network create yixing-edge` and set that name here,
# then `docker compose --profile bundled-nginx up -d --build`.
FIN_PROXY_NETWORK=nginx-proxy-manage_default

# === Omni (pick one) ===
OPPO_OWNER_ID=
OPPO_API_ID=
OPPO_API_KEY=
# OPPO_OMNI_ENV=/run/secrets/oppo-omniapi.env

# === Next server-only (compose shares FIN_API_TOKEN via env_file) ===
# FINANCE_API_INTERNAL_BASE is set in compose to http://api:8787/api/v1
# NEXT_PUBLIC_FINANCE_API_BASE=/api/v1  (path only; OK)
# FORBIDDEN: NEXT_PUBLIC_FIN_API_TOKEN
