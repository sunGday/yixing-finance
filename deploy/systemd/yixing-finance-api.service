[Unit]
Description=yixing-finance FastAPI
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/yixing-finance
EnvironmentFile=-/opt/yixing-finance/deploy/.env
Environment=FIN_REQUIRE_TOKEN=1
ExecStart=/opt/yixing-finance/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
