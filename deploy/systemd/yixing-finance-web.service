[Unit]
Description=yixing-finance Next web
After=network.target yixing-finance-api.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/yixing-finance/web
EnvironmentFile=-/opt/yixing-finance/deploy/.env
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_FINANCE_API_BASE=/api/v1
Environment=FINANCE_API_INTERNAL_BASE=http://127.0.0.1:8787/api/v1
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
