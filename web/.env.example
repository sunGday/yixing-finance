# 本地 next dev / next start 的默认值（未复制本文件时，next.config 也会注入 /api/v1）。
# 复制为 .env.local 后可改前缀。不要把密钥写进此文件，也不要提交 .env.local。
NEXT_PUBLIC_FINANCE_API_BASE=/api/v1

# next dev：rewrite 把浏览器的 /api/v1 转到这里（本机 open-dev）。
# production（next build && next start）：不 rewrite。Route Handler 代理到这里，
# 并设置 Authorization: Bearer $FIN_API_TOKEN。
# Pages 静态导出（STATIC_EXPORT=1）不使用这条，并强制不注入上面的 BASE。
FINANCE_API_INTERNAL_BASE=http://127.0.0.1:8787/api/v1

# 服务器专用。8787 为 open-dev 时可留空。禁止 NEXT_PUBLIC_FIN_API_TOKEN。
# FIN_API_TOKEN=

# Pages 项目站路径，仅 build:pages 注入。本地留空。
# NEXT_PUBLIC_BASE_PATH=/yixing-finance
